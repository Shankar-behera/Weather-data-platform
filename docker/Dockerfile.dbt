FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy dbt project
COPY dbt_weather/ /app/dbt_weather/
COPY duckdb/ /app/duckdb/

# Install dbt
RUN pip install --no-cache-dir \
    dbt-core==1.7.0 \
    dbt-duckdb==1.7.0

# Set environment variables
ENV DBT_PROFILES_DIR=/app/dbt_weather

# Create profiles.yml
RUN mkdir -p ~/.dbt && \
    echo "weather_analytics:" > ~/.dbt/profiles.yml && \
    echo "  target: dev" >> ~/.dbt/profiles.yml && \
    echo "  outputs:" >> ~/.dbt/profiles.yml && \
    echo "    dev:" >> ~/.dbt/profiles.yml && \
    echo "      type: duckdb" >> ~/.dbt/profiles.yml && \
    echo "      path: /app/duckdb/analytics.duckdb" >> ~/.dbt/profiles.yml && \
    echo "      schema: weather" >> ~/.dbt/profiles.yml

WORKDIR /app/dbt_weather

# Run dbt
CMD ["dbt", "build"]